# Ключи к бесплатным провайдерам текста. Хватит одного, лучше оба: когда у одного
# кончается дневная квота, конвейер продолжает работать на втором.
GEMINI_API_KEY=
GROQ_API_KEY=

# NVIDIA: сейчас даёт только текстовые модели. Чтобы заработала генерация
# картинок, нужно на странице модели (например FLUX.1-dev) на build.nvidia.com
# нажать «Get API Key» — доступ выдаётся на конкретную модель.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Голос: ключ не нужен, сервис бесплатный.
KADR_VOICE=ru-RU-DmitryNeural
KADR_VOICE_RATE=-3%

# Стадия разбора референса ждёт файл с транскрибацией:
#   yt-dlp --write-auto-subs --sub-langs en-orig --skip-download <ссылка>
KADR_TRANSCRIPT_PATH=

# Заметки о визуале ниши для паспорта стиля (когда будут скриншоты — сюда их разбор).
KADR_REFERENCE_NOTES=

# Текстовые модели — на том же ключе NVIDIA, что и картинки.
# Своя квота, не общая с Gemini и Groq. Проверены вживую:
#   deepseek-ai/deepseek-v4.1-flash        — самый быстрый (~1.5 с), строгий JSON
#   nvidia/nemotron-3-super-120b-a12b      — отвечает верным JSON
#   z-ai/glm-5.3-flash                     — медленнее (~17 с)
# Ключу НЕ выданы: mistralai/mistral-large-2-instruct, nvidia/llama-3.1-nemotron-ultra-253b-v1.
# Qwen-Image: страница витрины ссылается на тот же адрес flux.1-dev; пути /genai/qwen/* дают 404.
NVIDIA_TEXT_MODELS=deepseek-ai/deepseek-v4.1-flash,nvidia/nemotron-3-super-120b-a12b,z-ai/glm-5.3-flash
